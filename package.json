{
  "name": "restatic-team",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:integration": "tsx --env-file=.env.test tests/integration.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/admin.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "test:prepare": "tsx scripts/test-env.ts",
    "start": "node scripts/start.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "better-auth": "^1.7.7",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "file-type": "^22.1.1",
    "lucide-react": "^0.562.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/busboy": "^1.5.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
