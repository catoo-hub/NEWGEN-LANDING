---
import "@/styles/global.css";
import VideoPlayer from "../VideoPlayer.astro";
const { mode = "account" } = Astro.props;
const lang = Astro.params.lang === "en" ? "en" : "ru";
const ru = lang === "ru";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" />
    <title>{ru?'Кабинет':'Account'} — RE:STATIC</title>
  </head>
  <body class="portal">
    <div id="portal" data-lang={lang} data-mode={mode}>
      <header class="portal-header">
        <a href={`/${lang}/`} class="wordmark">
          RE:STATIC<span>TEAM / {ru ? "КАБИНЕТ" : "ACCOUNT"}</span>
        </a>
        <div class="header-tools">
          <a id="language-switch" href={`/${ru ? "en" : "ru"}/${mode}/`}>
            {ru ? "EN" : "RU"}
          </a>
          <span id="identity"></span>
          <button id="signout" hidden>
            {ru ? "Выйти" : "Sign out"}
          </button>
        </div>
      </header>
      <div id="notice" role="status" hidden></div>
      <section id="auth" class="auth-card" hidden></section>
      <div id="workspace" class="workspace" hidden>
        <aside>
          <p class="eyebrow">WORKSPACE / 01</p>
          <nav id="navigation" aria-label={ru ? "Кабинет" : "Workspace"}></nav>
          <div class="sidebar-note">
            <span class="status-dot"></span> RE:STATIC TEAM
            <br />
            <a href={`/${lang}/offer/`}>{ru ? "Оферта" : "Terms"}</a> ·{" "}
            <a href={`/${lang}/privacy/`}>
              {ru ? "Конфиденциальность" : "Privacy"}
            </a>
          </div>
        </aside>
        <main id="content" tabindex="-1">
          <div class="empty">{ru ? "Загрузка…" : "Loading…"}</div>
        </main>
      </div>
      <footer class="portal-footer">
        © RE:STATIC team 2026{" "}
        <a href={`/${lang}/`}>{ru ? "На сайт" : "Back to website"} ↗</a>
      </footer>
    </div>
    <template id="player-template">
      <VideoPlayer
        src=""
        poster=""
        title="RE:STATIC"
        duration={0}
        lang={lang}
      />
    </template>
    <script>
      import "../../client/portal";
    </script>
  </body>
</html>
<style is:global>
  .portal {
    margin: 0;
    background: #f7f7f5;
    color: #202020;
    font-family: Arial, Helvetica, sans-serif;
    min-height: 100vh;
  }
  .portal * {
    box-sizing: border-box;
  }
  .portal button,
  .portal input,
  .portal textarea,
  .portal select {
    font: inherit;
  }
  .portal button,
  .portal a {
    -webkit-tap-highlight-color: transparent;
  }
  .portal a {
    color: inherit;
  }
  .portal-header {
    padding: 25px 4vw;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #ddd;
    gap: 20px;
  }
  .wordmark {
    font-size: 27px;
    font-weight: 900;
    letter-spacing: -1.5px;
    text-decoration: none;
  }
  .wordmark span {
    display: block;
    font: 10px monospace;
    letter-spacing: 2px;
    margin-top: 6px;
  }
  .header-tools {
    display: flex;
    gap: 20px;
    align-items: center;
    font: 12px monospace;
  }
  .header-tools button {
    border: 0;
    background: none;
    cursor: pointer;
  }
  .workspace {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    max-width: 1600px;
    margin: auto;
    min-height: 75vh;
  }
  aside {
    padding: 36px 20px 30px 4vw;
    border-right: 1px solid #ddd;
  }
  #content {
    padding: 36px 4vw 60px;
    min-width: 0;
  }
  .eyebrow {
    font: 10px monospace;
    letter-spacing: 2px;
    color: #777;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  #navigation {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  #navigation button {
    border: 0;
    background: transparent;
    text-align: left;
    padding: 12px;
    border-radius: 8px;
    color: #777;
    cursor: pointer;
    font-size: 13px;
  }
  #navigation button:hover {
    background: #eee;
    color: #222;
  }
  #navigation button.active {
    background: #222;
    color: #fff;
  }
  #navigation .divider {
    height: 1px;
    background: #ddd;
    margin: 12px 0;
  }
  .sidebar-note {
    font: 10px/2 monospace;
    color: #777;
    margin-top: 40px;
  }
  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: #fa553c;
    border-radius: 50%;
    margin-right: 6px;
  }
  .portal-footer {
    padding: 24px 4vw;
    display: flex;
    justify-content: space-between;
    border-top: 1px solid #ddd;
    font: 10px monospace;
    color: #777;
  }
  h1 {
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1;
    letter-spacing: -2px;
    font-weight: 900;
    margin: 0;
  }
  h2 {
    font-size: 20px;
    letter-spacing: -0.5px;
    font-weight: 700;
  }
  h3 {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 12px;
  }
  .page-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 28px;
  }
  .muted {
    color: #777;
    font-size: 13px;
    line-height: 1.7;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 16px;
  }
  .panel,
  .order-card {
    background: white;
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    padding: 22px;
  }
  .order-card {
    text-align: left;
    cursor: pointer;
    color: inherit;
  }
  .order-card:hover {
    border-color: #999;
  }
  .order-card .meta {
    margin: 12px 0 0;
    display: flex;
    justify-content: space-between;
    font: 11px monospace;
    color: #777;
  }
  .badge {
    display: inline-block;
    border-radius: 4px;
    background: #eee;
    font: 10px monospace;
    text-transform: uppercase;
    padding: 5px 8px;
  }
  .badge.green {
    background: #e3f2e8;
    color: #257444;
  }
  .badge.red {
    background: #fce9e5;
    color: #a33323;
  }
  .badge.orange {
    background: #fff0d5;
    color: #916516;
  }
  .button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 12px 17px;
    border: 1px solid #222;
    border-radius: 7px;
    background: #222;
    color: white;
    font-size: 12px;
    cursor: pointer;
    text-decoration: none;
    gap: 8px;
  }
  .button.secondary {
    background: transparent;
    color: #222;
    border-color: #ddd;
  }
  .button.danger {
    background: #ac3828;
    border-color: #ac3828;
    color: white;
  }
  .button:disabled {
    opacity: 0.5;
    cursor: wait;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .form-grid .full {
    grid-column: 1/-1;
  }
  .portal label {
    display: block;
    font-size: 12px;
    line-height: 1.5;
  }
  .portal form input:not([type="checkbox"]),
  .portal form textarea,
  .portal form select {
    display: block;
    width: 100%;
    padding: 12px;
    margin-top: 7px;
    background: #fafafa;
    border: 1px solid #ddd;
    border-radius: 7px;
    font-size: 14px;
    color: #222;
  }
  .portal textarea {
    min-height: 110px;
    resize: vertical;
  }
  .portal label.check {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .portal label.check input {
    margin-top: 4px;
  }
  .portal input:focus,
  .portal textarea:focus,
  .portal select:focus {
    outline: 2px solid #999;
    outline-offset: 2px;
  }
  .portal button:focus-visible,
  .portal a:focus-visible {
    outline: 2px solid #888;
    outline-offset: 3px;
  }
  .empty {
    padding: 50px 20px;
    text-align: center;
    border: 1px dashed #ccc;
    border-radius: 12px;
    color: #777;
    font-size: 14px;
  }
  .auth-card {
    max-width: 460px;
    margin: 60px auto 90px;
    background: white;
    padding: 35px;
    border: 1px solid #ddd;
    border-radius: 16px;
  }
  .auth-card h1 {
    font-size: 35px;
    margin-bottom: 12px;
  }
  .auth-card form {
    display: grid;
    gap: 17px;
    margin: 25px 0;
  }
  .auth-links {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
  .auth-links button {
    border: 0;
    background: none;
    font-size: 12px;
    text-decoration: underline;
    cursor: pointer;
  }
  #notice {
    padding: 13px 20px;
    position: fixed;
    top: 100px;
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 90vw;
    border: 1px solid #ccc;
    background: #222;
    color: #fff;
    border-radius: 8px;
    font-size: 13px;
    z-index: 99;
  }
  .order-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 360px);
    gap: 20px;
  }
  .stack {
    display: grid;
    gap: 20px;
    align-content: start;
  }
  .details {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 14px;
    line-height: 1.8;
  }
  .definition {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    font-size: 13px;
  }
  .definition dt {
    font: 10px monospace;
    color: #777;
    margin-bottom: 5px;
  }
  .definition dd {
    margin: 0;
  }
  .chat-messages {
    max-height: 430px;
    overflow: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 20px;
  }
  .message {
    border: 1px solid #eee;
    border-radius: 9px;
    padding: 14px;
    overflow-wrap: anywhere;
  }
  .message.internal {
    background: #fff5df;
  }
  .message .meta {
    font: 10px monospace;
    color: #777;
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  .message p {
    white-space: pre-wrap;
    font-size: 13px;
    line-height: 1.6;
    margin: 8px 0;
  }
  .chat-form textarea {
    min-height: 75px;
  }
  .chat-form .actions {
    margin-top: 10px;
  }
  .file-list {
    display: grid;
    gap: 15px;
  }
  .file-list audio,
  .file-list img {
    max-width: 100%;
    width: 100%;
  }
  .file-list img {
    max-height: 350px;
    object-fit: contain;
    border-radius: 8px;
  }
  .file-list a {
    font-size: 12px;
    overflow-wrap: anywhere;
  }
  .upload-progress {
    width: 100%;
    margin-top: 10px;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 15px;
    margin-bottom: 24px;
  }
  .metric {
    background: #222;
    color: #fff;
    border-radius: 12px;
    padding: 22px;
  }
  .metric span {
    font: 10px monospace;
    color: #aaa;
    text-transform: uppercase;
  }
  .metric strong {
    display: block;
    font-size: 26px;
    margin-top: 12px;
    letter-spacing: -1px;
  }
  .table-wrap {
    overflow: auto;
  }
  .portal table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }
  .portal td,
  .portal th {
    padding: 14px 10px;
    border-bottom: 1px solid #eee;
    text-align: left;
    vertical-align: top;
  }
  .portal th {
    font: 10px monospace;
    color: #777;
  }
  .portfolio-cover {
    width: 100%;
    border-radius: 8px;
    aspect-ratio: 16/9;
    object-fit: contain;
    background: #eee;
  }
  .roster-card {
    position: relative;
    overflow: hidden;
  }
  .roster-initial {
    font-size: 80px;
    font-weight: 900;
    letter-spacing: -8px;
    color: #eee;
    margin: 10px 0;
  }
  .timeline {
    list-style: none;
    padding: 0;
    max-height: 240px;
    overflow: auto;
  }
  .timeline li {
    font: 10px/1.6 monospace;
    color: #777;
    border-bottom: 1px solid #eee;
    padding: 8px 0;
  }
  .split {
    display: flex;
    justify-content: space-between;
    gap: 15px;
  }
  .portal [hidden] {
    display: none !important;
  }
  .portal .spacer {
    height: 20px;
  }
  .portal details > summary {
    cursor: pointer;
    font-size: 13px;
    font-weight: 700;
  }
  .portal details form {
    margin-top: 20px;
  }
  .portal .legal-inline {
    font-size: 12px;
    line-height: 1.7;
  }
  .portal .link-button {
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .portal .big-price {
    font-size: 35px;
    font-weight: 900;
    letter-spacing: -1px;
    margin: 20px 0;
  }
  @media (max-width: 1000px) {
    .order-layout {
      grid-template-columns: 1fr;
    }
    .workspace {
      grid-template-columns: 180px minmax(0, 1fr);
    }
    aside {
      padding-left: 20px;
    }
    #content {
      padding: 30px 20px;
    }
  }
  @media (max-width: 700px) {
    .workspace {
      display: block;
    }
    aside {
      border-right: 0;
      border-bottom: 1px solid #ddd;
      padding: 12px 16px;
    }
    aside > .eyebrow,
    .sidebar-note {
      display: none;
    }
    #navigation {
      flex-direction: row;
      overflow: auto;
      gap: 4px;
    }
    #navigation button {
      white-space: nowrap;
      padding: 10px;
    }
    .divider {
      display: none;
    }
    .portal-header {
      padding: 20px 16px;
    }
    .wordmark {
      font-size: 24px;
    }
    .header-tools {
      gap: 12px;
    }
    .header-tools #identity {
      display: none;
    }
    #content {
      padding: 26px 16px 50px;
    }
    .form-grid {
      grid-template-columns: 1fr;
    }
    .auth-card {
      margin: 35px 16px;
      padding: 25px;
    }
    .page-heading {
      align-items: flex-start;
    }
    .definition {
      grid-template-columns: 1fr 1fr;
    }
    .panel {
      padding: 18px;
    }
    h1 {
      letter-spacing: -1px;
    }
  }
</style>
