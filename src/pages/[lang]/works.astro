---
import '@/styles/global.css';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import VideoPlayer from '@/components/VideoPlayer.astro';
import { catalog } from '@/server/services/catalog';
const { projects } = await catalog();
import { ui, defaultLang } from '@/i18n/ui';

if (!['ru','en','ko','ja'].includes(Astro.params.lang || '')) return new Response('Not found', { status: 404 });

const { lang } = Astro.params;
const t = ui[lang as keyof typeof ui] || ui[defaultLang];


---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{t['works.title']} | RE:STATIC</title>
	</head>
	<body class="bg-[#F8F8F8] selection:bg-black selection:text-white">
    <section class="relative w-full min-h-screen overflow-x-hidden">
      
      <Header />

      {/* --- Background Blobs (Reused) --- */}
      <div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
          <div class="absolute top-[-10%] right-[-5%] w-[40vw] h-[40vw] bg-neutral-300 rounded-full blur-[100px] animate-blob mix-blend-multiply"></div>
          <div class="absolute bottom-[10%] left-[-10%] w-[35vw] h-[35vw] bg-slate-300 rounded-[40%] blur-[80px] animate-blob animation-delay-2000 mix-blend-multiply"></div>
      </div>

      <main class="relative z-10 pt-32 px-4 md:px-12 pb-20">
        <div class="mb-20">
          <h1 class="text-[12vw] md:text-[10vw] leading-[0.85] font-black tracking-tighter text-[#1a1a1a] mix-blend-darken" set:html={t['works.title'].replace('\n', '<br/>')}>
          </h1>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-x-12 md:gap-y-24 w-full max-w-[1920px] mx-auto">
          {projects.map((project) => (
            <article class="group relative flex flex-col gap-4 min-w-0">
              {["GFX", "LOGO"].includes(project.platform) ? <img src={project.src} alt={project.title} class="rounded-2xl w-full object-contain" loading="lazy" /> : <VideoPlayer src={project.src} poster={project.poster} title={project.title} duration={project.duration} lang={lang} />}
              <div class="flex justify-between items-baseline gap-4 border-b border-black/10 pb-3 transition-colors group-hover:border-black/30">
                <div class="min-w-0">
                  <span class="block text-[10px] font-mono tracking-widest text-gray-500 mb-2 uppercase">{project.platform}</span>
                  <h2 class="text-xl md:text-2xl font-bold uppercase tracking-tight leading-tight">
                    <a href={project.url} target="_blank" rel="noopener noreferrer" class="hover:text-neutral-500 transition-colors focus-visible:outline-2 focus-visible:outline-offset-4">{project.title}<span class="inline-block text-base ml-2" aria-hidden="true">↗</span></a>
                  </h2>
                </div>
                <span class="text-xs font-mono text-gray-500">/{project.id}</span>
              </div>
            </article>
          ))}
        </div>
      </main>

    </section>

    <style>
      @keyframes blob {
        0% { transform: translate(0px, 0px) scale(1); }
        33% { transform: translate(30px, -50px) scale(1.1); }
        66% { transform: translate(-20px, 20px) scale(0.9); }
        100% { transform: translate(0px, 0px) scale(1); }
      }
      .animate-blob {
        animation: blob 15s infinite cubic-bezier(0.4, 0, 0.2, 1);
      }
      .animation-delay-2000 {
        animation-delay: 2s;
      }
    </style>
	  <Footer />
	</body>
</html>
