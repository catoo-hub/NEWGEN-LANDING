---
import LegalPage from '@/layouts/LegalPage.astro';
import privacy from '@/data/privacy.json';
if (!['ru','en','ko','ja'].includes(Astro.params.lang || '')) return new Response('Not found', { status: 404 });
const lang=Astro.params.lang === 'ru' ? 'ru' : 'en';
---
<LegalPage content={privacy[lang]} kind="privacy" />
